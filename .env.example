APP_NAME=Enterprise RAG Platform
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# Production Compose management-page listener. Use the server's private IP
# instead of 0.0.0.0 when the host has multiple network interfaces.
APP_HTTP_BIND_ADDRESS=0.0.0.0
APP_HTTP_PORT=18080
SERVICE_TOKEN=change-me-for-local-development
# Business-backend-only credential for /api/v1/assistant. Never distribute it to clients.
# Production rejects this example value: generate a value with
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ASSISTANT_SERVICE_TOKEN=change-me-for-assistant-integration
# Optional previous token during a rolling credential rotation.
ASSISTANT_SERVICE_TOKEN_PREVIOUS=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

POSTGRES_DB=rag_platform
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-dev-password
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://rag:rag-dev-password@127.0.0.1:15432/rag_platform
REQUIRED_POSTGRES_EXTENSIONS=vector,pg_search

REDIS_PASSWORD=rag-redis-password
REDIS_PORT=16379
REDIS_URL=redis://:rag-redis-password@127.0.0.1:16379/0
RQ_QUEUES=ingestion,index_build,maintenance
RQ_INDEX_JOB_TIMEOUT_SECONDS=7200
# Maintenance queue (Profile generation, KB deletion) job timeout, independent of index builds.
RQ_MAINTENANCE_JOB_TIMEOUT_SECONDS=7200

MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ROOT_USER=rag-minio
MINIO_ROOT_PASSWORD=rag-minio-password
MINIO_ACCESS_KEY=rag-minio
MINIO_SECRET_KEY=rag-minio-password
MINIO_SECURE=false
MINIO_DOCUMENT_BUCKET=rag-documents
MINIO_IMAGE_BUCKET=rag-images

READINESS_TIMEOUT_SECONDS=2.0
# 32-byte base64 key for encrypting API keys stored in model_config (ADR-0005).
# Required only when writing keys via PUT /api/v1/models/{id}/api-key.
MODEL_SECRET_KEY=replace-with-a-32-byte-base64-key-before-model-config-is-enabled
# Key rotation: set MODEL_SECRET_KEY (new) + PREVIOUS (old), then run
#   cd backend && ../.venv/bin/python -m app.tasks.key_rotation
MODEL_SECRET_KEY_VERSION=1
MODEL_SECRET_KEY_PREVIOUS=
MODEL_SECRET_KEY_PREVIOUS_VERSION=
MODEL_PROBE_TIMEOUT_SECONDS=15.0
EMBEDDING_DIMENSION=1024

# M0 online contract probes. Keep real non-production keys in .env only.
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
M0_TARGET_EMBEDDING_DIMENSION=1024
M0_PROVIDER_TIMEOUT_SECONDS=90

# M2 ingestion. "auto" may use deterministic fake vectors only outside staging/production.
# Deployed environments require an environment or model_config credential.
M2_EMBEDDING_PROVIDER=auto
M2_EMBEDDING_BATCH_SIZE=8
M2_DOCX_MAX_BYTES=52428800
M2_DOCX_MAX_ENTRIES=2000
M2_DOCX_MAX_UNCOMPRESSED_BYTES=209715200
M2_DOCX_MAX_ENTRY_BYTES=52428800
M2_DOCX_MAX_COMPRESSION_RATIO=100
M2_CHUNK_TARGET_CHARS=1200
M2_CHUNK_MAX_CHARS=2000
M2_CHUNK_OVERLAP_PARAGRAPHS=1
M2_PARENT_CHUNK_MAX_CHARS=8000

# M3 text RAG. "auto" uses a configured environment or model_config credential;
# only tests may fall back to the deterministic fake LLM.
M3_LLM_PROVIDER=auto
M3_VECTOR_TOP_K=10
M3_CONTEXT_MAX_CHUNKS=8
M3_CONTEXT_TOKEN_BUDGET=6000
M3_HISTORY_MAX_MESSAGES=10
M3_HISTORY_TOKEN_BUDGET=2000
M3_QUESTION_MAX_CHARS=4000
M3_PROMPT_MAX_CHARS=60000
M3_PROMPT_TOKEN_BUDGET=30000
M3_LLM_MAX_TOKENS=2048
M3_LLM_TEMPERATURE=0.1
M3_TRACE_RETAIN_PROMPT=true
M3_PROVIDER_TIMEOUT_SECONDS=120

# Document Profile generation (Profile Review). One short LLM draft call per
# document; a transient failure gets one retry and RAG remains unaffected.
PROFILE_GENERATION_CONCURRENCY=2
PROFILE_LLM_TIMEOUT_SECONDS=30
PROFILE_LLM_RETRY_ATTEMPTS=2
# Profile direct-route calibration. Multiple or weak Profile candidates always
# fall through to RAG; RAG alone may ask the user to choose a document.
PROFILE_DIRECT_THRESHOLD=0.84
PROFILE_CANDIDATE_THRESHOLD=0.60
PROFILE_DIRECT_GAP=0.08
PROFILE_CANONICAL_WEIGHT=0.60
PROFILE_SUMMARY_WEIGHT=0.25
PROFILE_ALIAS_WEIGHT=0.15
PROFILE_GENERIC_ALIAS_PENALTY=0.35

# Chat chain selection. legacy_rag = RAG-only (default, the main chain);
# technical_support = Support-first with RAG fallback (compatibility route).
CHAT_EXECUTION_MODE=legacy_rag
SUPPORT_HISTORY_MAX_MESSAGES=8
SUPPORT_LLM_MAX_TOKENS=2048
SUPPORT_LLM_TEMPERATURE=0.1
SUPPORT_RAG_FALLBACK_ENABLED=true

# M3 document routing thresholds (chunk scores aggregate per document).
M3_DOC_AGG_T_HIGH=0.9
M3_DOC_AGG_T_LOW=0.5
M3_DOC_AGG_RATIO=1.8
M3_DOC_AGG_MIN_HITS=2
M3_DOC_AGG_MAX_HITS=3
M3_DOC_STAY_SCORE=0.35
M3_DOC_SWITCH_GAP=0.25
M3_DOC_LOCK_BEST_FLOOR=0.75
M3_DOC_DELIVERY_MAX_TOKENS=8000

# M3 multi-turn retrieval query rewrite (follow-up questions only).
M3_QUERY_REWRITE_ENABLED=true
M3_QUERY_REWRITE_MAX_CHARS=40
M3_QUERY_REWRITE_MAX_TOKENS=192
M3_QUERY_REWRITE_TIMEOUT_SECONDS=8.0

# M4 multimodal ingestion. "auto" uses cloud credentials when present and deterministic
# fake providers otherwise; use "disabled" to intentionally skip one capability.
M4_OCR_PROVIDER=auto
M4_VISION_PROVIDER=auto
M4_IMAGE_CONCURRENCY=8
M4_OCR_MAX_TOKENS=4096
M4_VISION_MAX_TOKENS=1024
M4_MAX_OUTPUT_CHARS=20000
M4_PROVIDER_TIMEOUT_SECONDS=120

# M5 complete retrieval. Hybrid uses strict pg_search BM25 + pgvector RRF fusion.
# "auto" may use deterministic rerank only outside staging/production.
M5_RERANK_PROVIDER=auto
M5_BM25_TOP_K=10
M5_FUSION_TOP_K=20
M5_RERANK_TOP_N=10
M5_RRF_K=60
M5_RERANK_MAX_IMAGES_PER_DOCUMENT=1
M5_RERANK_IMAGE_BYTE_BUDGET=5242880
M5_PROVIDER_TIMEOUT_SECONDS=120

# Upstream model identifiers (must match the embedding dimension contract).
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
SILICONFLOW_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-8B
SILICONFLOW_OCR_MODEL=deepseek-ai/DeepSeek-OCR
ZHIPU_LLM_MODEL=glm-5.2
ZHIPU_VISION_MODEL=glm-5v-turbo

# Index garbage collection (keeps the N most recent indexes per KB).
INDEX_GC_ENABLED=true
INDEX_GC_RETENTION_COUNT=3
INDEX_GC_RETENTION_DAYS=7
# Fleet-wide periodic GC interval on the maintenance worker. 0 disables the
# periodic run; manual GC (admin button / POST /api/v1/gc) is always available.
INDEX_GC_INTERVAL_SECONDS=86400

# Assistant conversation and trace lifecycle. 0 conversation days keeps conversations forever.
CONVERSATION_RETENTION_DAYS=7
# Terminal Assistant requests without a conversation are retained for idempotent replay;
# 0 disables pruning. Requests linked to a conversation follow its lifecycle.
ASSISTANT_REQUEST_RETENTION_DAYS=7
TRACE_FULL_RETENTION_DAYS=7
TRACE_SUMMARY_RETENTION_DAYS=30

# Failed-request log retention (request_error_log table). 0 keeps rows forever.
REQUEST_ERROR_LOG_RETENTION_DAYS=30

# M7 release acceptance script controls (not application runtime settings).
M7_ACCEPTANCE_PORT=18007
M7_PRODUCTION_SMOKE_PORT=18008
M7_LOAD_REQUESTS=200
M7_LOAD_CONCURRENCY=32
M7_RAG_REQUESTS=50
M7_P95_LIMIT_MS=3000
M7_RECOVERY_TIMEOUT_SECONDS=90
M7_TASK_TIMEOUT_SECONDS=180
