APP_NAME=Enterprise RAG Platform
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
SERVICE_TOKEN=change-me-for-local-development
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

POSTGRES_DB=rag_platform
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-dev-password
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://rag:rag-dev-password@127.0.0.1:15432/rag_platform
REQUIRED_POSTGRES_EXTENSIONS=vector,pg_search

REDIS_PASSWORD=rag-redis-password
REDIS_PORT=16379
REDIS_URL=redis://:rag-redis-password@127.0.0.1:16379/0
RQ_QUEUES=ingestion,index_build,maintenance
RQ_INDEX_JOB_TIMEOUT_SECONDS=7200

MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ROOT_USER=rag-minio
MINIO_ROOT_PASSWORD=rag-minio-password
MINIO_ACCESS_KEY=rag-minio
MINIO_SECRET_KEY=rag-minio-password
MINIO_SECURE=false
MINIO_DOCUMENT_BUCKET=rag-documents
MINIO_IMAGE_BUCKET=rag-images

READINESS_TIMEOUT_SECONDS=2.0
MODEL_SECRET_KEY=replace-with-a-32-byte-base64-key-before-model-config-is-enabled
EMBEDDING_DIMENSION=1024

# M0 online contract probes. Keep real non-production keys in .env only.
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
M0_TARGET_EMBEDDING_DIMENSION=1024
M0_PROVIDER_TIMEOUT_SECONDS=90

# M2 ingestion. "auto" uses SiliconFlow when a key exists, otherwise deterministic fake vectors.
M2_EMBEDDING_PROVIDER=auto
M2_EMBEDDING_BATCH_SIZE=8
M2_DOCX_MAX_BYTES=52428800
M2_DOCX_MAX_ENTRIES=2000
M2_DOCX_MAX_UNCOMPRESSED_BYTES=209715200
M2_DOCX_MAX_ENTRY_BYTES=52428800
M2_DOCX_MAX_COMPRESSION_RATIO=100
M2_CHUNK_TARGET_CHARS=1200
M2_CHUNK_MAX_CHARS=2000
M2_CHUNK_OVERLAP_PARAGRAPHS=1
M2_PARENT_CHUNK_MAX_CHARS=8000

# M3 text RAG. "auto" uses Zhipu when a key exists, otherwise a deterministic fake LLM.
M3_LLM_PROVIDER=auto
M3_VECTOR_TOP_K=10
M3_CONTEXT_MAX_CHUNKS=8
M3_CONTEXT_TOKEN_BUDGET=6000
M3_HISTORY_MAX_MESSAGES=10
M3_HISTORY_TOKEN_BUDGET=2000
M3_QUESTION_MAX_CHARS=4000
M3_PROMPT_MAX_CHARS=60000
M3_LLM_MAX_TOKENS=2048
M3_LLM_TEMPERATURE=0.1
M3_LLM_THINKING_ENABLED=true
M3_TRACE_RETAIN_PROMPT=true
M3_PROVIDER_TIMEOUT_SECONDS=120

# M4 multimodal ingestion. "auto" uses cloud credentials when present and deterministic
# fake providers otherwise; use "disabled" to intentionally skip one capability.
M4_OCR_PROVIDER=auto
M4_VISION_PROVIDER=auto
M4_IMAGE_CONCURRENCY=8
M4_OCR_MAX_TOKENS=4096
M4_VISION_MAX_TOKENS=1024
M4_MAX_OUTPUT_CHARS=20000
M4_PROVIDER_TIMEOUT_SECONDS=120

# M5 complete retrieval. Hybrid uses strict pg_search BM25 + pgvector RRF fusion.
M5_RERANK_PROVIDER=auto
M5_BM25_TOP_K=10
M5_FUSION_TOP_K=20
M5_RERANK_TOP_N=10
M5_RRF_K=60
M5_RERANK_MAX_IMAGES_PER_DOCUMENT=1
M5_RERANK_IMAGE_BYTE_BUDGET=5242880
M5_PROVIDER_TIMEOUT_SECONDS=120

# M7 release acceptance script controls (not application runtime settings).
M7_ACCEPTANCE_PORT=18007
M7_PRODUCTION_SMOKE_PORT=18008
M7_LOAD_REQUESTS=200
M7_LOAD_CONCURRENCY=32
M7_RAG_REQUESTS=50
M7_P95_LIMIT_MS=3000
M7_RECOVERY_TIMEOUT_SECONDS=90
M7_TASK_TIMEOUT_SECONDS=180
