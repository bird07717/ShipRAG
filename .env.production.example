APP_ENV=production
LOG_LEVEL=INFO
SERVICE_TOKEN=
# Required by /api/v1/assistant/*; use a unique random value of at least 32 characters.
ASSISTANT_SERVICE_TOKEN=
# Keep empty except during a controlled Assistant Token rotation.
ASSISTANT_SERVICE_TOKEN_PREVIOUS=
CORS_ORIGINS=https://rag.example.internal

POSTGRES_DB=rag_platform
POSTGRES_USER=rag
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RQ_INDEX_JOB_TIMEOUT_SECONDS=7200
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_DOCUMENT_BUCKET=rag-documents
MINIO_IMAGE_BUCKET=rag-images

# Preserve the source value/version when restoring a database that contains
# encrypted model_config API keys. Generate a new key only for a new database.
MODEL_SECRET_KEY=
MODEL_SECRET_KEY_VERSION=1

SILICONFLOW_API_KEY=
ZHIPU_API_KEY=
# In production, auto requires the selected provider credential either here
# or encrypted in model_config. Embedding/LLM/Rerank never fall back to fake.
M2_EMBEDDING_PROVIDER=auto
M3_LLM_PROVIDER=auto
M3_CONTEXT_MAX_CHUNKS=8
# RAG-only. Single-strong/fact short answers remain shadow; explanations are enabled.
M3_RAG_CONFLICT_GUARD=true
M3_RAG_TITLE_RECALL=true
M3_RAG_SINGLE_STRONG_MODE=shadow
M3_RAG_FACT_QA_MODE=shadow
M3_RAG_EXPLANATION_MODE=enabled
M3_HISTORY_STRATEGY=focused
M3_RAG_SINGLE_STRONG_FLOOR=0.85
M3_RAG_SINGLE_STRONG_GAP=0.18
M4_OCR_PROVIDER=auto
M4_VISION_PROVIDER=auto
M4_IMAGE_CONCURRENCY=8
M5_RERANK_PROVIDER=auto

BACKEND_IMAGE=enterprise-rag-backend:1.0.1
FRONTEND_IMAGE=enterprise-rag-frontend:1.0.1
BACKEND_WORKERS=2
# Terminal Assistant requests without a conversation; 0 disables pruning.
ASSISTANT_REQUEST_RETENTION_DAYS=7
# Listen on all server interfaces; restrict port 18080 to approved intranet clients by firewall.
APP_HTTP_BIND_ADDRESS=0.0.0.0
APP_HTTP_PORT=18080
